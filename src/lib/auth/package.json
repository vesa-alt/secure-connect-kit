{
  "name": "sharedenv-login",
  "version": "1.0.0",
  "description": "Simple username + encoded-password login for React + Vite apps. React is the only dependency.",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["*.css"],
  "bin": { "sharedenv-hash-password": "./dist/hash-password.mjs" },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "exports": {
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./admin": { "types": "./dist/admin.d.ts", "default": "./dist/admin.js" },
    "./server": { "types": "./dist/auth.server.d.ts", "default": "./dist/auth.server.js" },
    "./password": { "types": "./dist/password.d.ts", "default": "./dist/password.js" },
    "./vite": { "types": "./dist/vite.d.ts", "default": "./dist/vite.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
    "./styles.css": "./dist/auth.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp auth.css hash-password.mjs dist/",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": { "vite": { "optional": true } },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
